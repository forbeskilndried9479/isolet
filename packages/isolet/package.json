{
  "name": "isolet",
  "version": "0.0.1",
  "description": "Package components into self-contained, isolated widgets",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/adapters/react.d.ts",
        "default": "./dist/adapters/react.js"
      },
      "require": {
        "types": "./dist/adapters/react.d.cts",
        "default": "./dist/adapters/react.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/adapters/vanilla.d.ts",
        "default": "./dist/adapters/vanilla.js"
      },
      "require": {
        "types": "./dist/adapters/vanilla.d.cts",
        "default": "./dist/adapters/vanilla.cjs"
      }
    },
    "./global": "./dist/index.iife.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^20.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.16"
  },
  "license": "MIT"
}
